generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id         String      @id @default(uuid())
  titleEn    String?
  titleAr    String?
  settingEn  String?
  settingAr  String?
  victimEn   String?
  victimAr   String?
  joinCode   String      @unique // Can still be used as a simple save/load session code
  status     String      @default("SETUP") // SETUP, ROLE_REVEAL, INVESTIGATION, FINISHED
  mode       String      @default("OFFLINE") // ONLINE or OFFLINE
  judgeId    String?     // ID of the player acting as judge
  createdAt  DateTime    @default(now())
  players    Player[]
  characters Character[]
  clues      Clue[]
  messages   Message[]
}

model Message {
  id        String   @id @default(uuid())
  gameId    String
  playerId  String
  content   String
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Player {
  id         String     @id @default(uuid())
  gameId     String
  playerName String
  isHost     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  character  Character?
  messages   Message[]
}

model Character {
  id         String  @id @default(uuid())
  gameId     String
  playerId   String? @unique
  nameEn     String
  nameAr     String
  motiveEn   String
  motiveAr   String
  secretEn   String
  secretAr   String
  alibiEn    String
  alibiAr    String
  game       Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player     Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
}

model Clue {
  id            String  @id @default(uuid())
  gameId        String
  descriptionEn String
  descriptionAr String
  type          String  @default("document") // e.g., polaroid, torn-paper, blood-stain
  isUnlocked    Boolean @default(false)
  game          Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
}
